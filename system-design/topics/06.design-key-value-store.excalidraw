    {
      "id": "J7SffMZr5iObUxFvQ5Zxe",
      "type": "text",
      "x": 922.5129294567596,
      "y": -12263.958256362266,
      "width": 487.6396484375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1881921750,
      "version": 101,
      "versionNonce": 1961369366,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779470657399,
      "link": null,
      "locked": false,
      "text": "Each design has to maintain a trade-off  between\n1) read\n2) write\n3) memory usage",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each design has to maintain a trade-off  between\n1) read\n2) write\n3) memory usage",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QwuCthlI5-YaTGVQrXFpQ",
      "type": "text",
      "x": 925.0182191703011,
      "y": -12140.750723267649,
      "width": 176.55987548828125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 2057321162,
      "version": 54,
      "versionNonce": 1545196746,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779470684807,
      "link": null,
      "locked": false,
      "text": "Another trade-off\n1) consistency\n2) availability",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Another trade-off\n1) consistency\n2) availability",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1DgheTNjKozCEwoJmwhLI",
      "type": "text",
      "x": 894.6031884946565,
      "y": -12027.857619834042,
      "width": 624.9395141601562,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 32251850,
      "version": 318,
      "versionNonce": 675090326,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779472533356,
      "link": null,
      "locked": false,
      "text": "Characteristics\n1. size of key-value pair is small\n2. ability to store big data\n3. High availability - system responds quickly even during failures\n4. High Scalability - can be scaled to support large data set\n5. Autoscaling\n6. Tunable Consistency\n7. Low latency",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Characteristics\n1. size of key-value pair is small\n2. ability to store big data\n3. High availability - system responds quickly even during failures\n4. High Scalability - can be scaled to support large data set\n5. Autoscaling\n6. Tunable Consistency\n7. Low latency",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y_i7yiHrO-h7F8QtvePhw",
      "type": "text",
      "x": 1553.731083709622,
      "y": -12392.787754706596,
      "width": 395.52783203125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 1162460106,
      "version": 34,
      "versionNonce": 2110133194,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779472186129,
      "link": null,
      "locked": false,
      "text": "Single Server Key Value Store",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Single Server Key Value Store",
      "autoResize": true,
