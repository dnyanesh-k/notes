      "roundness": null,
      "seed": 1901101142,
      "version": 135,
      "versionNonce": 32813526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779472428861,
      "link": null,
      "locked": false,
      "text": "1. Data Compression\n2. store frequently accessed data in mem and rest on disk",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Data Compression\n2. store frequently accessed data in mem and rest on disk",
      "autoResize": true,
      "lineHeight": 1.25
    },
