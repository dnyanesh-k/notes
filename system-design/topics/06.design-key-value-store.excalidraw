    },
    {
      "id": "fcKCW0dVlgFSVKlLLz6Rl",
      "type": "text",
      "x": 1574.8421948207329,
      "y": -12330.565532484374,
      "width": 368.999755859375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1537540118,
      "version": 76,
      "versionNonce": 1998117450,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779472357638,
      "link": null,
      "locked": false,
      "text": "Intuitive approach \nstore k-v pairs in hashtable in memory",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intuitive approach \nstore k-v pairs in hashtable in memory",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rZBTyJrCCGWNGTJ1dKcws",
      "type": "text",
      "x": 1574.1661965568442,
      "y": -12272.316088582465,
      "width": 470.8996887207031,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 123012554,
      "version": 126,
      "versionNonce": 772410902,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779472360181,
      "link": null,
      "locked": false,
      "text": "memory access is fast\nhowever fitting evrything in memory is impossible\ndue to memory constraint",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "memory access is fast\nhowever fitting evrything in memory is impossible\ndue to memory constraint",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7XGxUkvUGYt0deV9b7ihy",
      "type": "text",
      "x": 1575.7592141349692,
      "y": -12158.039321275606,
      "width": 571.1596069335938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
