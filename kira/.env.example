# Copy this file to .env and fill in values. Never commit .env.

# --- LLM provider (LiteLLM) ---
# Default: Groq free tier — https://console.groq.com
GROQ_API_KEY=

LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_CRITIC_MODEL=groq/llama-3.3-70b-versatile
# LLM_FALLBACK_MODEL=groq/llama-3.1-8b-instant

# --- Alternative providers (set key + change LLM_MODEL) ---
# OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini

# ANTHROPIC_API_KEY=
# LLM_MODEL=anthropic/claude-3-5-sonnet-20241022

# LiteLLM log level (ERROR | INFO)
LITELLM_LOG=ERROR
